---
import { ui } from '../utils/i18n';
const t = ui['es'];

const volunteers = [
  {
    keyBase: 'vol.navidad',
    icon: '🎄',
    colorClass: 'from-red-500/15 to-red-600/5 border-red-500/20 hover:border-red-400/40',
    dotClass:   'bg-red-400',
    ringClass:  'ring-red-900/50',
    tags: ['Hospital de Occidente', '2023 & 2024'],
  },
  {
    keyBase: 'vol.copan',
    icon: '💻',
    colorClass: 'from-sky-500/15 to-sky-600/5 border-sky-500/20 hover:border-sky-400/40',
    dotClass:   'bg-sky-400',
    ringClass:  'ring-sky-900/50',
    tags: ['UNAH – Campus Copán', '2024'],
  },
];
---

<section id="voluntariados" class="max-w-6xl mx-auto px-6 py-24">

  <!-- Encabezado -->
  <div class="mb-16">
    <h2 class="text-3xl font-bold text-white mb-2" data-i18n="section.volunteering">
      {t['section.volunteering']}
    </h2>
    <div class="w-20 h-1 bg-hector-primary/60"></div>
    <p class="text-gray-500 text-sm mt-4 max-w-xl" data-i18n="section.volunteering.subtitle">
      {t['section.volunteering.subtitle']}
    </p>
  </div>

  <!-- Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {volunteers.map((vol) => (
      <div
        class={`relative overflow-hidden rounded-2xl border bg-gradient-to-br p-7 transition-all duration-300 hover:scale-[1.02] ${vol.colorClass}`}
      >

        <!-- Ícono decorativo de fondo -->
        <span class="absolute -bottom-4 -right-4 text-7xl opacity-10 select-none pointer-events-none">
          {vol.icon}
        </span>

        <!-- Header -->
        <div class="flex items-start gap-4 mb-5">
          <div class={`w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-2xl flex-shrink-0 ring-4 ${vol.ringClass}`}>
            {vol.icon}
          </div>
          <div>
            <h3 class="text-white font-bold text-base leading-snug" data-i18n={`${vol.keyBase}.title`}>
              {t[`${vol.keyBase}.title`]}
            </h3>
            <p class="text-gray-400 text-xs mt-0.5" data-i18n={`${vol.keyBase}.org`}>
              {t[`${vol.keyBase}.org`]}
            </p>
          </div>
        </div>

        <!-- Descripción -->
        <p class="text-gray-400 text-sm leading-relaxed mb-5" data-i18n={`${vol.keyBase}.desc`}>
          {t[`${vol.keyBase}.desc`]}
        </p>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2">
          {vol.tags.map((tag) => (
            <span class="text-xs px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-gray-500">
              {tag}
            </span>
          ))}
        </div>

      </div>
    ))}
  </div>

</section>