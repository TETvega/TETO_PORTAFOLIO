---

<section id="proyectos" class="max-w-6xl mx-auto px-6 py-24">

  <div class="mb-16">
    <h2 class="text-3xl font-bold text-white mb-2" data-i18n="section.projects">
      {t['section.projects']}
    </h2>
    <div class="w-20 h-1 bg-hector-primary/60"></div>
  </div>

  <div class="space-y-16">
    {projects.map((proj) => (
      <article
        id={`proj-${proj.id}`}
        class={`rounded-3xl border border-white/10 bg-gradient-to-b ${proj.gradFrom} to-transparent ${proj.borderHover} overflow-hidden transition-all duration-300`}
      >

        <!-- ── 1. HEADER: nombre, rol, estado, badge ──────── -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-6 pt-6 pb-4">

          <!-- Izquierda: título + rol -->
          <div>
            <div class="flex items-center gap-3 flex-wrap">
              <h3 class="text-white font-bold text-2xl leading-tight" data-i18n={proj.titleKey}>
                {t[proj.titleKey]}
              </h3>
              <!-- Badge privado / público -->
              {proj.private
                ? <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-white/40">
                    <LockKeyhole size={10} aria-hidden="true" />
                    <span data-i18n="proj.private">Privado</span>
                  </span>
                : proj.openSource ? <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
                    <GitBranch size={10} aria-hidden="true" />
                    <span data-i18n="proj.opensource">Open Source</span>
                  </span> : null
              }
              {proj.labelKey && <span class="inline-flex items-center text-xs px-2.5 py-1 rounded-full bg-hector-primary/10 border border-hector-primary/20 text-hector-primary/80" data-i18n={proj.labelKey}>{t[proj.labelKey]}</span>}
            </div>
            <p class="text-gray-500 text-xs uppercase tracking-widest mt-1.5 font-medium" data-i18n={proj.role}>
              {t[proj.role]}
            </p>
          </div>

          <!-- Derecha: estado -->
          <span class="inline-flex items-center gap-1.5 self-start sm:self-auto text-xs px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-gray-400">
            <span class={`w-1.5 h-1.5 rounded-full ${proj.statusColor} animate-pulse`}></span>
            <span data-i18n={proj.status}>{t[proj.status]}</span>
          </span>

        </div>

        <!-- ── 2. CARRUSEL FULL WIDTH ─────────────────────── -->
        {proj.images.length > 0 ? <div class="relative bg-black overflow-hidden group" data-carousel={proj.id}>

          <!-- Track -->
          <div
            class="carousel-track flex transition-transform duration-500 ease-in-out"
            data-track={proj.id}
            style="will-change: transform;"
          >
            {proj.images.map((img) => (
              <div class="carousel-slide flex-shrink-0 w-full flex items-center justify-center bg-black"
                style="min-height: 240px;">
                {img.src
                  ? <img
                      src={img.src}
                      alt={img.alt}
                      data-i18n-alt={img.altKey}
                      class="w-full max-h-[520px] object-contain block"
                      loading="lazy"
                      decoding="async"
                    />
                  : (
                    <div class="w-full flex flex-col items-center justify-center gap-3 select-none py-24">
                      <span class="text-8xl opacity-20">{img.placeholder}</span>
                      <span class="text-xs text-white/20 tracking-widest uppercase">{img.alt}</span>
                    </div>
                  )
                }
              </div>
            ))}
          </div>

          <!-- Prev / Next -->
          <button
            class="carousel-prev absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/70 border border-white/15 text-white/60 hover:text-white hover:bg-black/90 flex items-center justify-center transition-all z-10 opacity-0 group-hover:opacity-100 backdrop-blur-sm"
            data-proj={proj.id} aria-label="Anterior" data-i18n-aria-label="proj.carousel.previous"
          >
            <ChevronLeft size={16} aria-hidden="true" />
          </button>
          <button
            class="carousel-next absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/70 border border-white/15 text-white/60 hover:text-white hover:bg-black/90 flex items-center justify-center transition-all z-10 opacity-0 group-hover:opacity-100 backdrop-blur-sm"
            data-proj={proj.id} aria-label="Siguiente" data-i18n-aria-label="proj.carousel.next"
          >
            <ChevronRight size={16} aria-hidden="true" />
          </button>

          <!-- Counter -->
          <div
            class="carousel-counter absolute bottom-3 right-4 text-xs px-2.5 py-1 rounded-full bg-black/70 border border-white/10 text-white/50 z-10 tabular-nums select-none backdrop-blur-sm"
            data-counter={proj.id}
          >
            1 / {proj.images.length}
          </div>

          <!-- Dots (solo si ≤ 8 slides) -->
          <div class="carousel-dots-wrap absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 z-10" data-dots={proj.id}>
            {proj.images.map((_, idx) => (
              <button
                class={`carousel-dot rounded-full transition-all duration-300 ${idx === 0 ? 'bg-white w-5 h-1.5' : 'bg-white/30 w-1.5 h-1.5'}`}
                data-proj={proj.id}
                data-idx={idx}
                aria-label={`Slide ${idx + 1}`}
              />
            ))}
          </div>

        </div> : <div class="flex min-h-[240px] items-center justify-center bg-gradient-to-br from-fuchsia-500/10 to-transparent px-6 text-center">
          <div class="flex flex-col items-center gap-3 text-fuchsia-200/70">
            <FileText size={48} strokeWidth={1.5} aria-hidden="true" />
            <span class="text-xs uppercase tracking-[0.2em]" data-i18n="proj.docs.note">{t['proj.docs.note']}</span>
          </div>
        </div>}

        <!-- ── 3. INFO: descripción + expand + tech + links ── -->
        <div class="px-6 py-6 space-y-5">

          <!-- Descripción corta -->
          <p class="text-gray-300 text-sm leading-relaxed" data-i18n={proj.shortKey}>
            {t[proj.shortKey]}
          </p>

          <!-- Expand: descripción larga -->
          <div>
            <div
              class="expand-wrapper overflow-hidden transition-all duration-500"
              style="max-height: 0px;"
              data-expand={proj.id}
            >
              <p class="text-gray-400 text-sm leading-relaxed pb-4 border-b border-white/5" data-i18n={proj.longKey}>
                {t[proj.longKey]}
              </p>
            </div>

            <!-- Botón "Ver más" — prominente -->
            <button
              class="expand-btn group/btn inline-flex items-center gap-2 mt-1 text-sm font-medium text-hector-primary hover:text-white border border-hector-primary/30 hover:border-hector-primary/70 hover:bg-hector-primary/10 px-4 py-2 rounded-full transition-all duration-200"
              data-expand={proj.id}
            >
              <span class="expand-label" data-i18n="proj.readmore">{t['proj.readmore']}</span>
              <ChevronDown className="expand-icon transition-transform duration-300" size={14} aria-hidden="true" />
            </button>
          </div>

          <!-- Separador -->
          <div class="border-t border-white/5"></div>

          <!-- Tech badges -->
          <div class="flex flex-wrap gap-2">
            {proj.tech.map((tech) => (
              <span class={`text-xs px-2.5 py-1 rounded-md border font-medium ${proj.techColor}`}>{tech}</span>
            ))}
          </div>

          <!-- Links a GitHub + nota privado -->
          {proj.links.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {proj.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:border-white/30 transition-all"
                >
                  <GitBranch size={12} aria-hidden="true" />
                  {link.label}
                </a>
              ))}
            </div>
          )}

          {proj.private && (
            <p class="text-xs text-gray-600 italic flex items-center gap-1.5">
              <LockKeyhole size={11} aria-hidden="true" />
              <span data-i18n="proj.private.note">{t['proj.private.note']}</span>
            </p>
          )}

        </div>
      </article>
    ))}
  </div>

</section>

<script>
  // ── Carrusel ─────────────────────────────────────────────────
  document.querySelectorAll('[data-track]').forEach((trackEl) => {
    const track    = trackEl as HTMLElement;
    const projId   = track.getAttribute('data-track')!;
    let current    = 0;
    const dots     = document.querySelectorAll(`.carousel-dot[data-proj="${projId}"]`);
    const dotsWrap = document.querySelector(`.carousel-dots-wrap[data-dots="${projId}"]`) as HTMLElement | null;
    const counter  = document.querySelector(`.carousel-counter[data-counter="${projId}"]`) as HTMLElement | null;
    const total    = track.querySelectorAll('.carousel-slide').length;

    if (dotsWrap && total > 8) dotsWrap.style.display = 'none';

    function goTo(idx: number) {
      current = (idx + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
      if (counter) counter.textContent = `${current + 1} / ${total}`;
      if (dotsWrap && total <= 8) {
        dots.forEach((d, i) => {
          const el = d as HTMLElement;
          el.classList.toggle('bg-white',    i === current);
          el.classList.toggle('w-5',         i === current);
          el.classList.toggle('bg-white/30', i !== current);
          el.classList.toggle('w-1.5',       i !== current);
        });
      }
    }

    document.querySelector(`.carousel-prev[data-proj="${projId}"]`)
      ?.addEventListener('click', () => goTo(current - 1));
    document.querySelector(`.carousel-next[data-proj="${projId}"]`)
      ?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot) =>
      dot.addEventListener('click', () =>
        goTo(Number((dot as HTMLElement).getAttribute('data-idx')))
      )
    );
  });

  // ── Expandir descripción ──────────────────────────────────────
  document.querySelectorAll('.expand-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id      = (btn as HTMLElement).getAttribute('data-expand')!;
      const wrapper = document.querySelector(`.expand-wrapper[data-expand="${id}"]`) as HTMLElement;
      const label   = btn.querySelector('.expand-label') as HTMLElement;
      const icon    = btn.querySelector('.expand-icon') as HTMLElement;
      const isOpen  = wrapper.style.maxHeight !== '0px' && wrapper.style.maxHeight !== '';
      const lang    = localStorage.getItem('lang') || 'es';

      if (isOpen) {
        wrapper.style.maxHeight = '0px';
        icon.style.transform    = 'rotate(0deg)';
        label.textContent       = lang === 'en' ? 'Read more' : 'Ver más';
        label.setAttribute('data-i18n', 'proj.readmore');
      } else {
        wrapper.style.maxHeight = wrapper.scrollHeight + 'px';
        icon.style.transform    = 'rotate(180deg)';
        label.textContent       = lang === 'en' ? 'Read less' : 'Ver menos';
        label.setAttribute('data-i18n', 'proj.readless');
      }
    });
  });
</script>
