---
import { ui } from '../utils/i18n';
const t = ui['es'];

const education = [
  {
    id: 'unah',
    type: 'university',
    icon: '🎓',
    institutionKey: 'edu.unah.institution',
    degreeKey:      'edu.unah.degree',
    periodKey:      'edu.unah.period',
    progressKey:    'edu.unah.progress',
    progress:       84,
    statusKey:      'edu.status.inprogress',
    statusColor:    'bg-emerald-400',
    accentFrom:     'from-hector-primary/10',
    borderColor:    'border-hector-primary/20 hover:border-hector-primary/50',
    badgeColor:     'text-hector-primary bg-hector-primary/10 border-hector-primary/20',
    barColor:       'bg-violet-400',
    highlights: ['edu.unah.h1','edu.unah.h2','edu.unah.h3','edu.unah.h4'],
  },
  {
    id: 'admon',
    type: 'university',
    icon: '📊',
    institutionKey: 'edu.admon.institution',
    degreeKey:      'edu.admon.degree',
    periodKey:      'edu.admon.period',
    progressKey:    'edu.admon.progress',
    progress:       25,
    statusKey:      'edu.status.inprogress',
    statusColor:    'bg-emerald-400',
    accentFrom:     'from-violet-500/10',
    borderColor:    'border-violet-500/20 hover:border-violet-400/50',
    badgeColor:     'text-violet-300 bg-violet-500/10 border-violet-500/20',
    barColor:       'bg-violet-400',
    highlights: ['edu.admon.h1','edu.admon.h2'],
  },
  {
    id: 'bach',
    type: 'highschool',
    icon: '🏫',
    institutionKey: 'edu.bach.institution',
    degreeKey:      'edu.bach.degree',
    periodKey:      'edu.bach.period',
    progressKey:    'edu.bach.progress',
    progress:       100,
    statusKey:      'edu.status.finished',
    statusColor:    'bg-sky-400',
    accentFrom:     'from-sky-500/10',
    borderColor:    'border-sky-500/20 hover:border-sky-400/50',
    badgeColor:     'text-sky-300 bg-sky-500/10 border-sky-500/20',
    barColor:       'bg-sky-400',
    highlights: ['edu.bach.h1','edu.bach.h2','edu.bach.h3','edu.bach.h4'],
  },
];
---

<section id="educacion" class="max-w-6xl mx-auto px-6 py-24">

  <div class="mb-16">
    <h2 class="text-3xl font-bold text-white mb-2" data-i18n="section.education">
      {t['section.education']}
    </h2>
    <div class="w-20 h-1 bg-hector-primary/60"></div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    {education.map((edu) => (
      <div class={`relative overflow-hidden rounded-2xl border bg-gradient-to-br ${edu.accentFrom} to-transparent ${edu.borderColor} p-7 flex flex-col gap-5 transition-all duration-300 hover:scale-[1.01] group`}>

        <!-- Ícono decorativo de fondo -->
        <span class="absolute -bottom-3 -right-3 text-8xl opacity-[0.06] select-none pointer-events-none">{edu.icon}</span>

        <!-- Header -->
        <div class="flex items-start justify-between gap-3">
          <div class={`w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-2xl flex-shrink-0`}>
            {edu.icon}
          </div>
          <span class={`inline-flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-full border font-medium mt-1 ${edu.badgeColor}`}>
            <span class={`w-1.5 h-1.5 rounded-full ${edu.statusColor} ${edu.progress < 100 ? 'animate-pulse' : ''}`}></span>
            <span data-i18n={edu.statusKey}>{t[edu.statusKey]}</span>
          </span>
        </div>

        <!-- Info -->
        <div>
          <h3 class="text-white font-bold text-base leading-snug mb-1" data-i18n={edu.degreeKey}>
            {t[edu.degreeKey]}
          </h3>
          <p class="text-gray-400 text-sm font-medium" data-i18n={edu.institutionKey}>
            {t[edu.institutionKey]}
          </p>
          <p class="text-gray-600 text-xs mt-0.5" data-i18n={edu.periodKey}>
            {t[edu.periodKey]}
          </p>
        </div>

        <!-- Barra de progreso -->
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-xs text-gray-500" data-i18n={edu.progressKey}>{t[edu.progressKey]}</span>
            <span class="text-xs font-bold text-white">{edu.progress}%</span>
          </div>
          <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
            <div
              class={`h-full rounded-full transition-all duration-700 ${edu.barColor}`}
              style={`width: ${edu.progress}%`}
            ></div>
          </div>
        </div>

        <!-- Highlights -->
        <ul class="space-y-2 pt-1 border-t border-white/5">
          {edu.highlights.map((key) => (
            <li class="flex items-start gap-2.5 text-xs text-gray-400 group-hover:text-gray-300 transition-colors">
              <span class={`mt-1 w-1 h-1 rounded-full flex-shrink-0 ${edu.barColor}`}></span>
              <span data-i18n={key}>{t[key]}</span>
            </li>
          ))}
        </ul>

      </div>
    ))}
  </div>

</section>