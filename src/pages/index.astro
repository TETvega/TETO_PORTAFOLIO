---
import Layout from "../layouts/Layout.astro";
import { GitBranch, BriefcaseBusiness } from "lucide-react";
import { ui } from "../utils/i18n";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import SoftSkills from "../components/Softskills.astro";
import Education from "../components/Education.astro";
import Courses from "../components/Courses.astro";
import Awards from "../components/Awards.astro";
import Volunteering from "../components/Volunteering.astro";

const t = ui["es"];
---

<Layout title="Héctor Martínez | Teto">
  <main class="min-h-screen bg-hector-dark text-white">
    <!-- ─── Hero ──────────────────────────────────────────── -->
    <section
      id="hero"
      class="min-h-screen flex items-center justify-center px-6 pt-20"
    >
      <div class="max-w-6xl w-full flex items-center gap-12 md:gap-16 relative">
        <!-- Columna izquierda: social vertical -->
        <div class="hidden sm:flex flex-col items-center gap-5">
          <a
            href="https://www.linkedin.com/in/héctormartínezvega"
            target="_blank"
            class="w-11 h-11 flex items-center justify-center rounded-lg bg-white/5 border border-white/10 text-gray-400 hover:text-hector-primary hover:border-hector-primary/50 hover:bg-hector-primary/10 transition-all hover:scale-110"
          >
            <BriefcaseBusiness size={18} aria-hidden="true" />
          </a>
          <a
            href="https://github.com/TETvega"
            target="_blank"
            class="w-11 h-11 flex items-center justify-center rounded-lg bg-white/5 border border-white/10 text-gray-400 hover:text-hector-primary hover:border-hector-primary/50 hover:bg-hector-primary/10 transition-all hover:scale-110"
          >
            <GitBranch size={18} aria-hidden="true" />
          </a>
          <div class="w-px h-16 bg-white/10"></div>
        </div>

        <!-- Centro: nombre y roles -->
        <div class="flex-1 min-w-0">
          <h1
            class="text-5xl sm:text-6xl md:text-8xl font-bold tracking-tighter mb-4 leading-none"
          >
            <span data-i18n="hero.name" class="text-hector-primary"
              >{t["hero.name"]}</span
            >
            <span class="text-white" data-i18n="hero.lastname"
              >{t["hero.lastname"]}</span
            >
          </h1>

          <p
            class="text-gray-400 text-base md:text-xl font-medium mb-2 tracking-wide"
            data-i18n="hero.roles"
          >
            {t["hero.roles"]}
          </p>
          <p
            class="text-gray-600 italic text-xs tracking-widest uppercase mb-8"
            data-i18n="hero.alias"
          >
            {t["hero.alias"]}
          </p>

          <a
            id="cv-link"
            href="/PDF/HECTOR_MARTINEZ_ES.pdf"
            download
            class="inline-flex items-center gap-2 text-hector-primary border border-hector-primary/40 px-5 py-2.5 rounded-full text-sm font-medium hover:bg-hector-primary/10 transition-all hover:scale-105"
          >
            <span data-i18n="hero.cv">{t["hero.cv"]}</span>
          </a>
        </div>

        <!-- Derecha: avatar -->
        <div class="hidden md:block flex-shrink-0">
          <div
            class="w-52 h-52 rounded-2xl overflow-hidden bg-white/5 border border-white/10"
          >
            <img
              src="/img/Perfil/perfil.webp"
              alt="Avatar de Héctor"
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center text-6xl\'>🧑‍💻</div>'"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Proyectos ─────────────────────────────────────── -->
    <Projects />

    <!-- ─── Experiencia Profesional ───────────────────────── -->
    <Experience />

    <!-- ─── Hard Skills ────────────────────────────────────── -->
    <Skills />

    <!-- ─── Soft Skills ────────────────────────────────────── -->
    <SoftSkills />

    <!-- ─── Educación ─────────────────────────────────────── -->
    <Education />

    <!-- ─── Cursos y Certificaciones ──────────────────────── -->
    <Courses />

    <!-- ─── Premios y Distinciones ────────────────────────── -->
    <Awards />

    <!-- ─── Voluntariados ─────────────────────────────────── -->
    <Volunteering />
  </main>
</Layout>

<!--
  Script i18n global.
  Escucha el evento 'languageChange' que emite LanguageSelector.tsx
  y actualiza todos los [data-i18n] de la página de una pasada.
-->
<script define:vars={{ translations: { es: ui["es"], en: ui["en"] } }}>
  function applyLang(lang) {
    const t = translations[lang] ?? translations["es"];
    document.querySelectorAll("[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n");
      if (t[key] !== undefined) el.textContent = t[key];
    });
    document.querySelectorAll("[data-i18n-alt]").forEach((el) => {
      const key = el.getAttribute("data-i18n-alt");
      if (key && t[key] !== undefined) el.setAttribute("alt", t[key]);
    });
    document.querySelectorAll("[data-i18n-aria-label]").forEach((el) => {
      const key = el.getAttribute("data-i18n-aria-label");
      if (key && t[key] !== undefined) el.setAttribute("aria-label", t[key]);
    });
    // 2. Actualizar el enlace del CV dinámicamente
    const cvLink = document.getElementById('cv-link');
    if (cvLink) {
      // Cambia la ruta según el idioma (es -> cv-es.pdf, en -> cv-en.pdf)
      cvLink.setAttribute('href', `/PDF/HECTOR_MARTINEZ_${lang.toUpperCase()}.pdf`);
    }
    document.documentElement.setAttribute("data-lang", lang);
    document.documentElement.setAttribute("lang", lang);
  }

  applyLang(localStorage.getItem("lang") || "es");
  window.addEventListener("languageChange", (e) => applyLang(e.detail.lang));
</script>
