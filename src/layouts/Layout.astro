---
import '../styles/global.css';
import LanguageSelector from '../components/LanguageSelector';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-hector-dark text-white selection:bg-hector-primary/30">

    <!-- ── Navbar ──────────────────────────────────────────── -->
    <nav class="fixed top-0 w-full z-50 bg-hector-dark/80 backdrop-blur-md border-b border-white/5">
      <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">

        <!-- Logo -->
        <a href="#" class="text-xl font-bold tracking-tighter hover:text-hector-primary transition cursor-pointer">
          HÉCTOR<span class="text-hector-primary">.</span>DEV
        </a>

        <!-- Nav links — desktop -->
        <div class="hidden lg:flex gap-7 text-sm font-medium text-gray-400">
          <a href="#proyectos"     class="nav-link hover:text-white transition-colors" data-i18n="nav.projects">Proyectos</a>
          <a href="#experiencia"   class="nav-link hover:text-white transition-colors" data-i18n="nav.experience">Experiencia</a>
          <a href="#skills"        class="nav-link hover:text-white transition-colors" data-i18n="nav.skills">Stack</a>
          <a href="#educacion"     class="nav-link hover:text-white transition-colors" data-i18n="nav.education">Educación</a>
          <a href="#premios"       class="nav-link hover:text-white transition-colors" data-i18n="nav.awards">Premios</a>
        </div>

        <!-- Derecha: hamburger móvil + lang selector -->
        <div class="flex items-center gap-4">
          <!-- Hamburger — solo mobile/tablet -->
          <button
            id="mobile-menu-btn"
            class="lg:hidden w-9 h-9 flex flex-col items-center justify-center gap-1.5 rounded-lg bg-white/5 border border-white/10 hover:border-white/20 transition-all"
            aria-label="Menú"
          >
            <span class="ham-line w-5 h-px bg-white/70 transition-all duration-300"></span>
            <span class="ham-line w-5 h-px bg-white/70 transition-all duration-300"></span>
            <span class="ham-line w-3 h-px bg-white/70 transition-all duration-300 self-start ml-1"></span>
          </button>

          <div class="w-px h-5 bg-white/10 hidden lg:block"></div>
          <LanguageSelector client:load />
        </div>

      </div>

      <!-- Menú mobile (desplegable) -->
      <div
        id="mobile-menu"
        class="lg:hidden overflow-hidden transition-all duration-300 border-t border-white/5"
        style="max-height: 0px;"
      >
        <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-1">
          <a href="#proyectos"   class="mobile-nav-link py-2.5 px-3 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all" data-i18n="nav.projects">Proyectos</a>
          <a href="#experiencia" class="mobile-nav-link py-2.5 px-3 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all" data-i18n="nav.experience">Experiencia</a>
          <a href="#skills"      class="mobile-nav-link py-2.5 px-3 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all" data-i18n="nav.skills">Stack</a>
          <a href="#softskills"  class="mobile-nav-link py-2.5 px-3 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all" data-i18n="nav.softskills">Habilidades</a>
          <a href="#educacion"   class="mobile-nav-link py-2.5 px-3 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all" data-i18n="nav.education">Educación</a>
          <a href="#cursos"      class="mobile-nav-link py-2.5 px-3 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all" data-i18n="nav.courses">Cursos</a>
          <a href="#premios"     class="mobile-nav-link py-2.5 px-3 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all" data-i18n="nav.awards">Premios</a>
          <a href="#voluntariados" class="mobile-nav-link py-2.5 px-3 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-all" data-i18n="nav.volunteering">Voluntariados</a>
        </div>
      </div>
    </nav>

    <slot />

    <!-- ── Footer ──────────────────────────────────────────── -->
    <footer class="py-10 border-t border-white/5">
      <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-gray-600 text-sm">
          © 2026 <span class="text-gray-500 font-medium">Héctor René Martínez Vega</span>
          · Santa Rosa de Copán, Honduras
        </p>
        <div class="flex items-center gap-3">
          <a href="https://github.com/TETvega" target="_blank"
            class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 border border-white/10 text-gray-500 hover:text-white hover:border-white/20 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/héctormartínezvega" target="_blank"
            class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 border border-white/10 text-gray-500 hover:text-white hover:border-white/20 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
        </div>
      </div>
    </footer>

  </body>
</html>

<script>
  // ── Hamburger menu ──────────────────────────────────────────
  const btn   = document.getElementById('mobile-menu-btn');
  const menu  = document.getElementById('mobile-menu');
  const lines = btn?.querySelectorAll('.ham-line');
  let open    = false;

  btn?.addEventListener('click', () => {
    open = !open;
    if (menu) menu.style.maxHeight = open ? menu.scrollHeight + 'px' : '0px';
    // Animar las tres líneas → X
    if (lines) {
      lines[0].classList.toggle('rotate-45',  open);
      lines[0].classList.toggle('translate-y-[7px]', open);
      lines[1].classList.toggle('-rotate-45', open);
      lines[1].classList.toggle('-translate-y-[1px]', open);
      lines[2].classList.toggle('opacity-0',  open);
    }
  });

  // Cerrar al hacer click en un link del menú mobile
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      open = false;
      if (menu) menu.style.maxHeight = '0px';
      if (lines) {
        lines[0].classList.remove('rotate-45', 'translate-y-[7px]');
        lines[1].classList.remove('-rotate-45', '-translate-y-[1px]');
        lines[2].classList.remove('opacity-0');
      }
    });
  });

  // ── Highlight nav link activo al hacer scroll ───────────────
  const sections = ['proyectos','experiencia','skills','softskills','educacion','cursos','premios','voluntariados'];
  const navLinks  = document.querySelectorAll('.nav-link, .mobile-nav-link');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        navLinks.forEach((link) => {
          const href = link.getAttribute('href') ?? '';
          link.classList.toggle('text-white', href === `#${entry.target.id}`);
          link.classList.toggle('text-gray-400', href !== `#${entry.target.id}`);
        });
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px' });

  sections.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>